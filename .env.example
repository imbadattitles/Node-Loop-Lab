# Copy this file before the first server deployment:
#   cp .env.example .env
#
# The application listens only on the Ubuntu host loopback interface.
# Your system Nginx proxies the public domain to this port.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Public origin without a trailing slash. It is embedded into canonical,
# hreflang, Open Graph and sitemap URLs during the Next.js build.
SITE_URL=https://node-loop-lab.example.com

# Redis is also loopback-only. The published port is useful for local study;
# the application container itself connects over the private Compose network.
REDIS_PORT=6379

# The PostgreSQL service stores only disposable training schemas on tmpfs.
# Keep this password URL-safe because Compose embeds it into DATABASE_URL.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
# Used only by the PostgreSQL initialization/maintenance role, never by Next.js.
POSTGRES_ADMIN_PASSWORD=replace-with-a-different-long-password

# Node Loop Lab is behind exactly one trusted system reverse proxy (Nginx).
# This lets public rate limits see the visitor IP from X-Forwarded-For.
TRUST_PROXY=1

# Optional local-only observability stack:
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Replace this value before exposing Grafana through a reverse proxy.
GRAFANA_ADMIN_PASSWORD=change-me
