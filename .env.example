# Copy this file before the first server deployment:
#   cp .env.example .env
#
# The application listens only on the Ubuntu host loopback interface.
# Your system Nginx proxies the public domain to this port.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Public origin without a trailing slash. It is embedded into canonical,
# hreflang, Open Graph and sitemap URLs during the Next.js build.
SITE_URL=https://node-loop-lab.example.com

# Redis is also loopback-only. The published port is useful for local study;
# the application container itself connects over the private Compose network.
REDIS_PORT=6379

# Node Loop Lab is behind exactly one trusted system reverse proxy (Nginx).
# This lets public rate limits see the visitor IP from X-Forwarded-For.
TRUST_PROXY=1
